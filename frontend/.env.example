# URL interne du serveur Rust, jamais exposée au navigateur.
API_BASE_URL=http://127.0.0.1:8080
# Derrière un proxy HTTPS : origine publique exacte autorisée pour les écritures.
# APP_ORIGIN=https://qomune.fr
# Définir aussi COOKIE_SECURE=true dans l'environnement du backend derrière HTTPS.

# Clé serveur de mesure des pages vues, identique côté Rust et Next.js (32 caractères minimum).
# Jamais de préfixe NEXT_PUBLIC_ pour ce secret.
# QOMUNE_METRICS_KEY=remplacer-par-une-cle-privee
