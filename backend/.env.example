# Exporter ces variables avant de lancer Rust ou le script commun.
API_BIND=127.0.0.1:8080
# Le mode production est volontairement indisponible avant l'intégration FranceConnect + RNE.
QOMUNE_MODE=prototype
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=qomune_prototype
# Utilisé uniquement pour les nouveaux comptes de démonstration.
# QOMUNE_DEMO_PASSWORD=definir-en-prive
# Activer uniquement avec un accès HTTPS.
COOKIE_SECURE=false
# Secret administrateur distinct des élus (16 à 200 caractères).
# Sans cette variable, Rust seul ne crée aucun accès administrateur.
# Le lanceur npm run dev génère automatiquement un secret local dans backend/data/administration-password.txt.
# QOMUNE_ADMIN_PASSWORD=remplacer-par-un-secret-personnel

# Clé serveur de mesure des pages vues, identique côté Rust et Next.js (32 caractères minimum).
# Jamais de préfixe NEXT_PUBLIC_ pour ce secret.
# QOMUNE_METRICS_KEY=remplacer-par-une-cle-privee
